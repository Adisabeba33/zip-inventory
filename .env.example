# ---------------------------------------------------------------------------
# Independent Dispensary Inventory Index - environment configuration
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_index

# --- Release gates (spec sections 43, 61, 89) ------------------------------
# The 21+ interstitial. Kept configurable so counsel can set the final mode.
AGE_GATE_ENABLED=true

# Search-engine indexing of retailer inventory pages. MUST stay false until
# the legal release gate in docs/LEGAL-RELEASE-GATES.md is signed off.
PUBLIC_INDEXING_ENABLED=false

# Master switch for the public site. While false the app serves a
# staging/private notice instead of the public index.
PUBLIC_LAUNCH_ENABLED=false

# --- Service identity ------------------------------------------------------
SERVICE_NAME=Inventory Index
SERVICE_PUBLIC_URL=http://localhost:3000
CONTACT_CORRECTIONS_EMAIL=corrections@example.com
CONTACT_SOURCE_OWNER_EMAIL=sources@example.com
CONTACT_LEGAL_EMAIL=legal@example.com

# --- Crawler ---------------------------------------------------------------
# Identifiable, non-masquerading user agent (spec section 30).
CRAWLER_USER_AGENT=InventoryIndexBot/1.0 (+http://localhost:3000/crawler; crawler@example.com)
CRAWLER_CONTACT_EMAIL=crawler@example.com
# Hard ceiling on observations per source per day.
CRAWLER_MAX_RUNS_PER_SOURCE_PER_DAY=1
# Raw payload retention in hours (spec section 34). Max 72.
RAW_RETENTION_HOURS=48
# Set to true to allow the worker to actually make outbound HTTP requests.
# With this false the worker plans and reports but never fetches.
CRAWLER_NETWORK_ENABLED=false

# --- Admin -----------------------------------------------------------------
# Bearer token for the admin API/dashboard. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Cache invalidation ping from the worker after a snapshot is published.
# Leave unset to let pages wait out their normal revalidation window.
WEB_REVALIDATE_URL=http://localhost:3000/api/internal/revalidate

# Vercel/serverless: point at a pooled endpoint and keep the pool small.
# Defaults to 2 on Vercel or Lambda, 10 elsewhere.
DATABASE_POOL_MAX=
